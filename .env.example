# SSEN account email that the NeRDA key was issued to.
NERDA_USERNAME=
# Long-term key from https://nerda.ssen.co.uk. Shown once, valid 90 days.
NERDA_API_KEY=
# Optional. Limits discovery to one substation uuid.
NERDA_SUBSTATION_ID=
# Private Vercel Blob token, added when the store exists.
BLOB_READ_WRITE_TOKEN=
